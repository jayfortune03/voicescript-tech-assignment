generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum JobStatus {
  NEW
  ASSIGNED
  TRANSCRIBED
  IN_REVIEW // Tambahkan ini agar alurnya jelas
  REVIEWED
  COMPLETED
}

enum LocationType {
  PHYSICAL
  REMOTE
}

enum Role {
  ADMIN // Tambahkan ADMIN
  REPORTER
  EDITOR
}

model User {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  email       String  @unique // Wajib untuk Login
  password    String // Wajib untuk Auth
  role        Role
  city        String?
  isAvailable Boolean @default(true)

  reporterJobs Job[]     @relation("ReporterJobs")
  editorJobs   Job[]     @relation("EditorJobs")
  payments     Payment[] // Relasi balik ke pembayaran
}

model Job {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseName     String
  duration     Int
  locationType LocationType
  city         String?
  status       JobStatus    @default(NEW)
  version      Int          @default(1)

  reporterId String? @db.Uuid
  editorId   String? @db.Uuid

  reporter User?     @relation("ReporterJobs", fields: [reporterId], references: [id])
  editor   User?     @relation("EditorJobs", fields: [editorId], references: [id])
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Tambahkan Index untuk mempercepat pencarian data
  @@index([status])
  @@index([reporterId])
  @@index([editorId])
}

model Payment {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId  String @db.Uuid // jobId juga harus Uuid karena Job.id adalah Uuid
  userId String @db.Uuid
  amount Int
  role   Role

  job  Job  @relation(fields: [jobId], references: [id])
  user User @relation(fields: [userId], references: [id]) // Relasi eksplisit

  createdAt DateTime @default(now())
}
